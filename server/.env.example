# Server Configuration
PORT=5000
NODE_ENV=development

# Google Gemini API Key
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB Connection URL
# If local MongoDB is running: mongodb://localhost:27017/gemini_chatgpt_db
# Or MongoDB Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/gemini_chatgpt_db
MONGODB_URI=mongodb://localhost:27017/gemini_chatgpt_db
