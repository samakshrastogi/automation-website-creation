{
  "name": "gemini-chatgpt-hybrid-monorepo",
  "version": "1.0.0",
  "description": "Full-stack ChatGPT & Gemini hybrid interface with Glassmorphism, 3D Canvas, GSAP animations, React, Node.js, and MongoDB",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=client",
    "start": "npm run start --workspace=server",
    "install:all": "npm install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "react",
    "nodejs",
    "mongodb",
    "gemini",
    "chatgpt",
    "glassmorphism",
    "gsap",
    "threejs",
    "monorepo"
  ],
  "author": "",
  "license": "MIT"
}
